# Unsloth trainer image — builds on the same NGC base as Dockerfile but
# adds unsloth + trl 0.24 + cut-cross-entropy + bitsandbytes for the
# huikang 0.85-LB Nemotron-H reproduction.
#
# Pinned to match /fsx/zzsamshi/nemotron-auto-research/.venv so the pod
# and the local 8-GPU smoke produce the same tensors:
#   torch         2.10.0
#   transformers  4.57.6
#   accelerate    1.13.0
#   datasets      4.3.0           (downgraded from 4.8.4 — trl 0.24 needs ≤4.4)
#   peft          0.19.1
#   trl           0.24.0
#   unsloth       2026.5.2
#   unsloth_zoo   2026.5.1
#   bitsandbytes  0.49.2
#
# Iteration remains "save file → kubectl apply -f job.yaml" — no COPY of
# repo code into the image; it lives on the FSx PVC.
#
# Build + push:
#   cd agent_evolve/backends/tinkerlite/elastic/k8s/image
#   ./build_and_push.sh unsloth-latest        # uses Dockerfile.unsloth via env
#   # or:
#   DOCKERFILE=Dockerfile.unsloth ./build_and_push.sh unsloth-v1

FROM nvcr.io/nvidia/pytorch:25.09-py3

RUN pip install --no-cache-dir --upgrade pip \
 && pip uninstall -y \
      torch torchvision torchaudio torchao \
      flash-attn flash-attn-2 flashinfer flashinfer-python \
      || true \
 && pip install --no-cache-dir \
      "torch==2.10.0" \
      "torchvision==0.25.0" \
      "transformers==4.57.6" \
      "peft==0.19.1" \
      "accelerate==1.13.0" \
      "datasets==4.3.0" \
      "bitsandbytes==0.49.2" \
      "wandb" \
      "kubernetes>=31.0" \
      "pyyaml>=6.0" \
      "numpy<3.0"

# trl 0.24 + unsloth stack. `--no-deps` so unsloth doesn't drag in a
# different torch; we already have 2.10.0 installed above.
RUN pip install --no-cache-dir --no-deps \
      "trl==0.24.0" \
      "unsloth==2026.5.2" \
      "unsloth_zoo==2026.5.1" \
      "cut-cross-entropy" \
      "triton==3.6.0"

# Nemotron-H mamba_ssm + causal_conv1d (same as Dockerfile).
RUN printf 'APT::Acquire::Retries "5";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\n' \
      > /etc/apt/apt.conf.d/99-retries \
 && sed -i 's|http://archive.ubuntu.com/ubuntu|http://ap-southeast-3.ec2.archive.ubuntu.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://ap-southeast-3.ec2.archive.ubuntu.com/ubuntu|g' \
      /etc/apt/sources.list.d/*.sources /etc/apt/sources.list 2>/dev/null || true \
 && apt-get update \
 && apt-get install -y --no-install-recommends wget gnupg ca-certificates git \
 && wget -qO /tmp/cuda-keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
 && dpkg -i /tmp/cuda-keyring.deb \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      cuda-nvcc-12-8 \
      cuda-cudart-dev-12-8 \
      cuda-nvrtc-dev-12-8 \
 && rm -rf /var/lib/apt/lists/* /tmp/cuda-keyring.deb

ENV CUDA_HOME_MAMBA=/usr/local/cuda-12.8
RUN PATH="${CUDA_HOME_MAMBA}/bin:${PATH}" \
    CUDA_HOME="${CUDA_HOME_MAMBA}" \
    TORCH_CUDA_ARCH_LIST="9.0" \
    MAMBA_FORCE_BUILD=TRUE \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE \
    pip install --no-cache-dir --no-build-isolation \
      "causal-conv1d @ git+https://github.com/Dao-AILab/causal-conv1d.git@v1.6.1" \
      "mamba-ssm @ git+https://github.com/state-spaces/mamba.git@v2.3.1"

# Default env — WANDB_DISABLED overridden per-job via env block.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    NCCL_DEBUG=WARN \
    TOKENIZERS_PARALLELISM=false \
    PYTHONPATH=/fsx/zzsamshi/a-evolve \
    HOME=/tmp

WORKDIR /fsx/zzsamshi/a-evolve
